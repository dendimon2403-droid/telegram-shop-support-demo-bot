# Copy this file to .env and fill in the values. Never commit .env.

# Required: token from @BotFather
BOT_TOKEN=

# Optional: your Telegram numeric user id (get it from @userinfobot).
# Enables /admin and order notifications.
ADMIN_ID=

# AI support: anthropic | openai | mock
# "mock" needs no key and answers from a small built-in FAQ (good for demos).
LLM_PROVIDER=mock
LLM_API_KEY=
# Defaults: claude-haiku-5-5 (anthropic), gpt-4o-mini (openai)
LLM_MODEL=
# Only for OpenAI-compatible servers (default https://api.openai.com/v1)
LLM_BASE_URL=

# Where the SQLite file and saved receipts live
DATA_DIR=data
